# AthenaK input file for unit tests of the line scans across MeshBlocks and ranks with
# static mesh refinement in 2D. Two separated level 3 regions on the same lines along
# x1, so those lines run fine -> coarse -> fine, with level 0 MeshBlocks between them
# (r = 8 jumps). MeshBlocks are 12x12 cells, so level 3 MeshBlock faces straddle the
# cells of level 0 MeshBlocks.

<comment>
problem   = line scan unit test across MeshBlocks, 2D SMR with two regions

<job>
basename  = line_scan_test          # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 144        # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 3.0        # maximum value of X1
ix1_bc    = periodic   # inner-X1 boundary flag
ox1_bc    = periodic   # outer-X1 boundary flag

nx2       = 48         # Number of zones in X2-direction
x2min     = 0.0        # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 12         # Number of cells in each MeshBlock, X1-dir
nx2       = 12         # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement

<refined_region1>
level     = 3
x1min     = 0.4
x1max     = 0.45
x2min     = 0.4
x2max     = 0.45

<refined_region2>
level     = 3
x1min     = 2.4
x1max     = 2.45
x2min     = 0.4
x2max     = 0.45

<time>
evolution  = static    # dynamic/kinematic/static
cfl_number = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0         # cycle limit
tlim       = 0         # time limit

<hydro>                # stores the scanned fields in u0
eos         = ideal    # EOS type
reconstruct = plm      # spatial reconstruction method
rsolver     = advect   # Riemann-solver to be used (static evolution requires advect)
gamma       = 1.4      # gamma = C_p/C_v

<problem>
pgen_name = line_scan
