# AthenaK input file for unit tests of the block local line scans.
# The mesh and meshblock sizes are overridden from the command line by the test suite.

<comment>
problem   = line scan unit test

<job>
basename  = line_scan_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 16         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = periodic   # inner-X1 boundary flag
ox1_bc    = periodic   # outer-X1 boundary flag

nx2       = 24         # Number of zones in X2-direction
x2min     = 0.0        # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 40         # Number of zones in X3-direction
x3min     = 0.0        # minimum value of X3
x3max     = 1.0        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 8          # Number of cells in each MeshBlock, X1-dir
nx2       = 12         # Number of cells in each MeshBlock, X2-dir
nx3       = 20         # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = static    # dynamic/kinematic/static
cfl_number = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0         # cycle limit
tlim       = 0         # time limit

<hydro>                  # unused by the test, but AthenaK requires a physics module
eos         = ideal    # EOS type
reconstruct = plm      # spatial reconstruction method
rsolver     = advect   # Riemann-solver to be used (static evolution requires advect)
gamma       = 1.4      # gamma = C_p/C_v

<problem>
pgen_name = line_scan
