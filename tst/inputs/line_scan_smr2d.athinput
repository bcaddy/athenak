# AthenaK input file for unit tests of the line scans across MeshBlocks and ranks with
# static mesh refinement in 2D. One level 3 region, so lines through it cross levels 0
# to 3 via the 2:1 buffers. MeshBlocks are 8x4 cells, so a level 3 MeshBlock's face is
# narrower than a level 0 cell (r = 8 > nx2 = 4) for scans along x1.

<comment>
problem   = line scan unit test across MeshBlocks, 2D SMR

<job>
basename  = line_scan_test          # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 2.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 32         # Number of zones in X2-direction
x2min     = -0.5       # minimum value of X2
x2max     = 0.5        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 8          # Number of cells in each MeshBlock, X1-dir
nx2       = 4          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement

<refined_region1>
level     = 3
x1min     = 1.05
x1max     = 1.1
x2min     = 0.05
x2max     = 0.07

<time>
evolution  = static    # dynamic/kinematic/static
cfl_number = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0         # cycle limit
tlim       = 0         # time limit

<hydro>                # stores the scanned fields in u0
eos         = ideal    # EOS type
reconstruct = plm      # spatial reconstruction method
rsolver     = advect   # Riemann-solver to be used (static evolution requires advect)
gamma       = 1.4      # gamma = C_p/C_v

<problem>
pgen_name = line_scan
