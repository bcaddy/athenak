# AthenaK input file for unit tests of the line scans across MeshBlocks and ranks with
# adaptive mesh refinement. The problem generator checks the scans on the initial mesh.
# A user refinement criterion then refines a region that moves every cycle, and the
# final function checks the same scans again on the refined mesh. The fluid is at rest
# with uniform pressure, so the evolution only needs to stay valid.

<comment>
problem   = line scan unit test across MeshBlocks, AMR

<job>
basename  = line_scan_test          # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 64         # Number of zones in X2-direction
x2min     = 0.0        # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = 0.0        # minimum value of X3
x3max     = 1.0        # maximum value of X3
ix3_bc    = outflow    # inner-X3 boundary flag
ox3_bc    = outflow    # outer-X3 boundary flag

<meshblock>
nx1       = 8          # Number of cells in each MeshBlock, X1-dir
nx2       = 8          # Number of cells in each MeshBlock, X2-dir
nx3       = 8          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement          = adaptive  # type of refinement
num_levels          = 4         # number of levels including the root level
ncycle_check        = 1         # cycles between checks of the refinement criteria
refinement_interval = 1         # minimum cycles between refinements of a MeshBlock
max_nmb_per_rank    = 1024      # memory is allocated for this many MeshBlocks

<amr_criterion0>
method = user

<time>
evolution  = dynamic   # dynamic/kinematic/static
integrator = rk2       # time integration algorithm
cfl_number = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 6         # cycle limit
tlim       = 1.0e10    # time limit

<hydro>                # stores the scanned fields in u0
eos         = ideal    # EOS type
reconstruct = plm      # spatial reconstruction method
rsolver     = llf      # Riemann-solver to be used
gamma       = 1.4      # gamma = C_p/C_v

<problem>
pgen_name = line_scan
