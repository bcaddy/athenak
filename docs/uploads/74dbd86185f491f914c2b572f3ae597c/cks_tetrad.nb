  RowBox[{"dl3dy", "->", 
   RowBox[{
    RowBox[{"-", "y"}], "*", 
    RowBox[{"z", "/", 
     RowBox[{"(", 
      RowBox[{"r", "*", "qa"}], ")"}]}]}]}], "]"}]}], "Code",
