Cell[CellGroupData[{

Cell["Metric Derivatives", "Subsubsection",
 CellChangeTimes->{{3.8429641380398283`*^9, 3.842964141352113*^9}, {
  3.8429642279572077`*^9, 3.842964230659896*^9}, {3.843649391311256*^9, 
