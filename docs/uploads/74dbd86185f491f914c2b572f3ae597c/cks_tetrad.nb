          TagBox[
           RowBox[{"(", 
            RowBox[{"1", ",", "0", ",", "0"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", "dl3dx1"}], ",", 
       "\n", " ", "\n", " ", 
       RowBox[{
        RowBox[{"wa", "[", 
